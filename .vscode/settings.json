{
  // Форматирование и линт при Ctrl+S
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    // Вертикальная линия по границе max_width из rustfmt.toml
    "editor.rulers": [100]
  },

  // rust-analyzer гоняет проверку при каждом сохранении файла
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.check.extraArgs": [
    "--",
    "-W",
    "clippy::pedantic",
    "-D",
    "warnings"
  ],

  // Весь CodeLens от rust-analyzer выключен: "N implementations", "Run | Debug" и т.п.
  "rust-analyzer.lens.enable": false,

  // Миникарта (блок-превью справа) отключена
  "editor.minimap.enabled": false,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
